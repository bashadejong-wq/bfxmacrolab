# Kopieer naar tradingview/.env en vul in.

# BIAS 5.0 (mirror_bias50, mirror_bias50_paar, mirror_bias50_samenvatting), anon-sleutel
BIAS_SUPABASE_URL=https://bbamgexpkehbserhdpii.supabase.co
BIAS_SUPABASE_KEY=

# Events uit het BFX Macro Lab-dashboard (macro_events_calendar).
# Zelfde waarden als VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY in de app. Leeg = geen events.
SUPABASE_URL=
SUPABASE_KEY=

# Staan de tijden in macro_events_calendar in UTC? (zonder tijdzone-aanduiding)
EVENT_TIMES_ARE_UTC=true

# Venster en filters
DAYS_BACK=7
DAYS_AHEAD=21
CURRENCIES=USD,EUR,GBP,JPY,CHF,AUD,NZD,CAD
MIN_IMPACT=2

# auto = zelf in TradingView zetten, manual = alleen bestand via Telegram sturen
DELIVERY=auto
TV_CHART_URL=https://www.tradingview.com/chart/
HEADLESS=false
# BROWSER_CHANNEL=chrome

# Meldingen (optioneel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
