# Kopieer naar tradingview/.env en vul in.

# BIAS 5.0 (mirror_bias50, mirror_bias50_paar, mirror_bias50_samenvatting), anon-sleutel
BIAS_SUPABASE_URL=https://bbamgexpkehbserhdpii.supabase.co
BIAS_SUPABASE_KEY=

# Events (mirror_agenda_events_site, dezelfde opgeschoonde agenda als de website). Zelfde project als BIAS 5.0.
# Zelfde URL/anon-sleutel als hierboven. Leeg = geen events.
SUPABASE_URL=https://bbamgexpkehbserhdpii.supabase.co
SUPABASE_KEY=
SUPABASE_SCHEMA=

# Staan de tijden in macro_events_calendar in UTC? (zonder tijdzone-aanduiding)
EVENT_TIMES_ARE_UTC=true

# Venster en filters
DAYS_BACK=7
DAYS_AHEAD=21
CURRENCIES=USD,EUR,GBP,JPY,CHF,AUD,NZD,CAD
MIN_IMPACT=2

# auto = zelf in TradingView zetten, manual = alleen bestand via Telegram sturen
DELIVERY=auto
# Aparte TradingView-layout voor de automatisering (id uit de URL /chart/<id>/ en exacte naam)
TV_LAYOUT_ID=
TV_LAYOUT_NAME=BFX Automatisering
HEADLESS=false
# BROWSER_CHANNEL=chrome

# Meldingen (optioneel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
