//@version=6
// BFX-STRUCTURE-ENGINE
// ONDERZOEKSVERSIE — GEEN BEWEZEN EDGE. Geen koop/verkoopsignalen, geen handelsadvies, geen automatische uitvoering.
// Alleen prijsdata (geen volume, geen macro). Regels: docs/structure/STRUCTUUR-CONTRACT-0.1.md
indicator("BFX Structure Engine 0.1", shorttitle = "BFX STR 0.1", overlay = true, max_lines_count = 150, max_labels_count = 150, max_boxes_count = 40, max_bars_back = 500)

// ═══ 0. Instellingen ═══════════════════════════════════════════
const string GW = "Weergave"
const string GH = "HYPOTHESE-parameters (niet bewezen)"
const string GZ = "Zones (HYPOTHESE)"
i_mode    = input.string("Compact", "Weergave", options = ["Minimal", "Compact", "Expanded"], group = GW)
i_pos     = input.string("Linksonder", "Positie kaart", options = ["Rechtsboven", "Rechtsonder", "Linksboven", "Linksonder"], group = GW)
i_spacer  = input.int(0, "Lege regels boven kaart", minval = 0, maxval = 8, group = GW)
i_tz      = input.string("Europe/Amsterdam", "Tijdzone weergave", group = GW)
i_drawS   = input.bool(true, "Teken swingstructuur", group = GW)
i_drawI   = input.bool(true, "Teken internal structuur", group = GW)
i_drawF   = input.bool(false, "Teken fractalstructuur", group = GW)
i_drawSw  = input.bool(true, "Teken sweeps", group = GW)
i_drawZ   = input.bool(true, "Teken zones", group = GW)
i_zVar    = input.string("Alle", "Zonevariant tonen", options = ["Alle", "OB-P", "OB-F", "OB-R"], group = GW)
i_zShow   = input.int(2, "Max. actieve zones per richting", minval = 0, maxval = 5, group = GW)
i_eq      = input.bool(true, "Teken equilibrium (50%) van de swingrange", group = GW)
i_conf    = input.bool(false, "Markeer bevestigingsmoment swingpivots", group = GW)
i_maxDraw = input.int(10, "Max. lijnen/labels per laag", minval = 2, maxval = 30, group = GW)
i_rowH4   = input.bool(true, "Kaart: 4H-swingrij", group = GW)
i_rowD    = input.bool(true, "Kaart: daily-swingrij", group = GW)
h_lenS    = input.int(10, "Swing: pivotlengte (bars links én rechts)", minval = 3, group = GH)
h_lenI    = input.int(5, "Internal: pivotlengte", minval = 2, group = GH)
h_lenF    = input.int(2, "Fractal: pivotlengte", minval = 1, group = GH)
h_atrLen  = input.int(14, "ATR-lengte", minval = 2, group = GH)
h_buf     = input.float(0.05, "Breakbuffer × ATR", minval = 0, step = 0.01, tooltip = "BoS/CHoCH: de close moet minstens dit voorbij het niveau liggen.", group = GH)
h_body    = input.bool(false, "Break vereist hele body voorbij niveau", group = GH)
h_swWick  = input.float(0.3, "Sweep: min. wickaandeel van de candle", minval = 0, maxval = 1, step = 0.05, group = GH)
h_mit     = input.float(50, "Zone GEBRUIKT bij mitigatie (%)", minval = 5, maxval = 100, group = GZ)
h_zAge    = input.int(300, "Zone verloopt na (bars)", minval = 20, group = GZ)
h_zMaxH   = input.float(1.5, "Zone: max. hoogte × ATR", minval = 0.2, step = 0.1, group = GZ)
h_fvgLook = input.int(20, "OB-F: zoek FVG in laatste n bars", minval = 3, maxval = 100, group = GZ)
const string GC = "CBO-box (HYPOTHESE, regels CBO_0.1)"
const string GR = "Referentielijnen"
i_cbo     = input.bool(true, "CBO-box tonen en koppelen", group = GC)
c_volLen  = input.int(20, "Gerealiseerde vol: lengte", minval = 5, group = GC)
c_volPct  = input.int(250, "Vol-percentiel: venster (bars)", minval = 50, group = GC)
c_lowVol  = input.float(15, "Lage vol < percentiel", group = GC)
c_highVol = input.float(85, "Hoge vol > percentiel", group = GC)
c_compVol = input.float(40, "Compressie: vol < percentiel", group = GC)
c_erLen   = input.int(20, "Efficiency ratio: lengte", minval = 5, group = GC)
c_erTrend = input.float(0.35, "Trend: ER ≥", group = GC)
c_erChaos = input.float(0.12, "Chaotisch: ER <", group = GC)
c_expMult = input.float(2.0, "Expansie: bar-range ≥ × ATR", group = GC)
c_nMin    = input.int(8, "Box: min. bars", minval = 3, group = GC)
c_nMax    = input.int(24, "Box: max. bars", minval = 5, group = GC)
c_wMax    = input.float(1.25, "Box: max. breedte × ATR", group = GC)
c_tol     = input.float(0.15, "Test-tolerantie × boxbreedte", group = GC)
c_tMin    = input.int(2, "Min. tests boven én onder", minval = 1, group = GC)
c_nSeal   = input.int(3, "Verzegelen na n bars zonder nieuw extreem", minval = 1, group = GC)
c_expiry  = input.float(2.0, "Verval: geen breakout binnen × boxduur", group = GC)
c_body    = input.float(0.5, "Breakout: min. body-aandeel buiten box", group = GC)
c_accK    = input.int(2, "Acceptatie: closes buiten box", minval = 1, group = GC)
i_refs    = input.bool(true, "Referentielijnen tonen", group = GR)
i_refOpen = input.bool(false, "Ook D/W Open als referentie", group = GR)
i_refTaken = input.bool(false, "Ook geraakte niveaus tonen (vervaagd)", group = GR)
r_max     = input.int(3, "Max. referenties", minval = 1, maxval = 6, group = GR)
r_dist    = input.float(1.5, "Alleen binnen × daily ATR van de koers", minval = 0.2, step = 0.1, group = GR)

// ═══ 1. Typen en kleuren ════════════════════════════════════════
type Piv
    float price
    int   oBar
    int   oTime
    int   cBar
    int   cTime
    bool  broken = false
    bool  swept = false

type Lvl
    string tag
    int    dir = 0
    int    stage = 0
    Piv    hi
    Piv    lo
    float  tTop
    float  tBot
    int    nBos = 0
    int    nChoch = 0
    int    nSweep = 0
    string lastEv = ""
    int    lastEvTime

type Zone
    string id
    string kind
    string src
    int    dir
    float  top
    float  bot
    int    oTime
    int    cBar
    int    cTime
    int    st = 0
    float  pen = 0.0
    int    tests = 0
    bool   inside = false
    string why = ""
    bool   vis = false
    box    bx

bool dark = (color.r(chart.bg_color) * 299 + color.g(chart.bg_color) * 587 + color.b(chart.bg_color) * 114) / 1000 < 128
color t1c = dark ? #E6E8EE : #1A1D24
color t2c = dark ? #9AA1B2 : #555C6B
color t3c = dark ? #6E7586 : #8A909E
color bgc = dark ? color.new(#131722, 6) : color.new(#FFFFFF, 6)
color cBull = #26A65B
color cBear = #E5484D
color cAmb  = #F0A020

float atr = ta.atr(h_atrLen)
int tfSec = timeframe.in_seconds()

// ═══ 2. Structuurlaag ═══════════════════════════════════════════
// Eén laag één bar verder, alleen op gesloten candles. Een pivot dat op déze bar bevestigt telt pas vanaf de volgende bar.
// brk: ±1 BoS · ±2 CHoCH · ±3 eerste break vanuit neutraal (teken = richting). sw: +1 bullish sweep (low genomen), −1 bearish sweep (high genomen).
stepLvl(Lvl s, float ph, float pl, int L) =>
    int brk = 0
    float bP = na
    int bT = na
    int bB = na
    int sw = 0
    float sP = na
    int sT = na
    if barstate.isconfirmed
        float b = h_buf * atr
        float upRef = h_body ? math.min(open, close) : close
        float dnRef = h_body ? math.max(open, close) : close
        float rng = high - low
        if not na(s.hi) and not s.hi.broken
            if upRef > s.hi.price + b
                s.hi.broken := true
                brk := s.dir == 1 ? 1 : s.dir == 0 ? 3 : 2
                bP := s.hi.price
                bT := s.hi.oTime
                bB := s.hi.oBar
            else if not s.hi.swept and high > s.hi.price and close < s.hi.price and rng > 0 and (high - math.max(open, close)) / rng >= h_swWick
                s.hi.swept := true
                sw := -1
                sP := s.hi.price
                sT := s.hi.oTime
        if brk == 0 and not na(s.lo) and not s.lo.broken
            if dnRef < s.lo.price - b
                s.lo.broken := true
                brk := s.dir == -1 ? -1 : s.dir == 0 ? -3 : -2
                bP := s.lo.price
                bT := s.lo.oTime
                bB := s.lo.oBar
            else if sw == 0 and not s.lo.swept and low < s.lo.price and close > s.lo.price and rng > 0 and (math.min(open, close) - low) / rng >= h_swWick
                s.lo.swept := true
                sw := 1
                sP := s.lo.price
                sT := s.lo.oTime
        if brk != 0
            int d = brk > 0 ? 1 : -1
            int ab = math.abs(brk)
            if ab == 1
                s.stage := s.stage == 1 ? 2 : 3
                s.nBos += 1
            else
                s.stage := 1
                s.nChoch += ab == 2 ? 1 : 0
            s.dir := d
            s.lastEv := (ab == 1 ? "BoS" : ab == 2 ? "CHoCH" : "Break") + (d == 1 ? " ↑" : " ↓")
            s.lastEvTime := time
        if sw != 0
            s.nSweep += 1
            if s.stage >= 2 and sw == -s.dir
                s.stage := 4
        if not na(ph)
            s.hi := Piv.new(ph, bar_index - L, time[L], bar_index, time)
            s.tTop := ph
        else if not na(s.tTop)
            s.tTop := math.max(s.tTop, high)
        if not na(pl)
            s.lo := Piv.new(pl, bar_index - L, time[L], bar_index, time)
            s.tBot := pl
        else if not na(s.tBot)
            s.tBot := math.min(s.tBot, low)
    [brk, bP, bT, bB, sw, sP, sT]

pdOf(Lvl s) =>
    float top = s.tTop
    float bot = s.tBot
    na(top) or na(bot) or top <= bot ? na : (close - bot) / (top - bot) * 100

var Lvl lS = Lvl.new("S")
var Lvl lI = Lvl.new("I")
var Lvl lF = Lvl.new("F")
float phS = ta.pivothigh(high, h_lenS, h_lenS)
float plS = ta.pivotlow(low, h_lenS, h_lenS)
float phI = ta.pivothigh(high, h_lenI, h_lenI)
float plI = ta.pivotlow(low, h_lenI, h_lenI)
float phF = ta.pivothigh(high, h_lenF, h_lenF)
float plF = ta.pivotlow(low, h_lenF, h_lenF)
[bS, bPS, bTS, bBS, wS, wPS, wTS] = stepLvl(lS, phS, plS, h_lenS)
[bI, bPI, bTI, bBI, wI, wPI, wTI] = stepLvl(lI, phI, plI, h_lenI)
[bF, bPF, bTF, bBF, wF, wPF, wTF] = stepLvl(lF, phF, plF, h_lenF)

// ═══ 3. Hogere timeframes (technische oriëntatie, geen macro) ═══
// expr[1] + lookahead_on = laatste gesloten HTF-candle; alleen opgevraagd als de rij aan staat (lazy).
htfState(int L) =>
    var Lvl s = Lvl.new("H")
    float ph = ta.pivothigh(high, L, L)
    float pl = ta.pivotlow(low, L, L)
    [x1, x2, x3, x4, x5, x6, x7] = stepLvl(s, ph, pl, L)
    int d = s.dir
    int g = s.stage
    float p = pdOf(s)
    [d[1], g[1], p[1]]

int h4Dir = na
int h4Stg = na
float h4Pd = na
if i_rowH4 and tfSec < 14400
    [a1, a2, a3] = request.security(syminfo.tickerid, "240", htfState(h_lenS), lookahead = barmerge.lookahead_on)
    h4Dir := a1
    h4Stg := a2
    h4Pd := a3
int dDir = na
int dStg = na
float dPd = na
if i_rowD and tfSec < 86400
    [c1, c2, c3] = request.security(syminfo.tickerid, "D", htfState(h_lenS), lookahead = barmerge.lookahead_on)
    dDir := c1
    dStg := c2
    dPd := c3

// ═══ 4. Tekenen: structuur en sweeps ════════════════════════════
var array<line>  lnS = array.new<line>()
var array<label> lbS = array.new<label>()
var array<line>  lnI = array.new<line>()
var array<label> lbI = array.new<label>()
var array<line>  lnF = array.new<line>()
var array<label> lbF = array.new<label>()
var array<line>  lnW = array.new<line>()
var array<label> lbW = array.new<label>()

trim(array<line> la, array<label> lb) =>
    while la.size() > i_maxDraw
        la.shift().delete()
    while lb.size() > i_maxDraw
        lb.shift().delete()

drawBrk(array<line> la, array<label> lb, int brk, float p, int t0, string pre, string sty, int w) =>
    if brk != 0 and not na(p) and not na(t0)
        color c = brk > 0 ? cBull : cBear
        int ab = math.abs(brk)
        string tx = pre + (ab == 1 ? "BoS" : ab == 2 ? "CHoCH" : "Break")
        la.push(line.new(t0, p, time, p, xloc = xloc.bar_time, color = color.new(c, 15), style = sty, width = w))
        lb.push(label.new(int((t0 + time) / 2), p, tx, xloc = xloc.bar_time, style = brk > 0 ? label.style_label_down : label.style_label_up, color = color.new(c, 100), textcolor = c, size = size.tiny, tooltip = tx + " op close " + str.format_time(time, "dd/MM HH:mm", i_tz) + " · niveau " + str.tostring(p, format.mintick)))
        trim(la, lb)

drawSweep(int sw, float p, int t0, string pre) =>
    if sw != 0 and not na(p) and not na(t0)
        color c = sw > 0 ? cBull : cBear
        float ext = sw > 0 ? low : high
        lnW.push(line.new(t0, p, time, p, xloc = xloc.bar_time, color = color.new(c, 45), style = line.style_dotted, width = 1))
        lbW.push(label.new(time, ext, pre + "Sweep", xloc = xloc.bar_time, style = sw > 0 ? label.style_label_up : label.style_label_down, color = color.new(c, 100), textcolor = c, size = size.tiny, tooltip = "Absorptie: wick door " + str.tostring(p, format.mintick) + ", close terug binnen · " + str.tostring(math.abs(ext - p) / atr, "0.00") + " ATR voorbij het niveau. Context, geen entry."))
        trim(lnW, lbW)

// Breekt een hogere laag hetzelfde niveau op dezelfde bar, dan tekent alleen die hogere laag (geen dubbele labels).
bool dupI = i_drawS and bS != 0 and bI != 0 and bPI == bPS
bool dupF = (i_drawI and bI != 0 and bF != 0 and bPF == bPI) or (i_drawS and bS != 0 and bF != 0 and bPF == bPS)
if i_drawS
    drawBrk(lnS, lbS, bS, bPS, bTS, "", line.style_solid, 2)
if i_drawI and not dupI
    drawBrk(lnI, lbI, bI, bPI, bTI, "i-", line.style_dashed, 1)
if i_drawF and not dupF
    drawBrk(lnF, lbF, bF, bPF, bTF, "f-", line.style_dotted, 1)
// Per bar één sweeplabel: de hoogste laag die sweept.
if i_drawSw
    if wS != 0
        drawSweep(wS, wPS, wTS, "")
    else if wI != 0
        drawSweep(wI, wPI, wTI, "i-")
    else if i_drawF and wF != 0
        drawSweep(wF, wPF, wTF, "f-")

var string swTxt = "–"
if wF != 0
    swTxt := "fractal " + (wF > 0 ? "bullish" : "bearish") + " · " + str.tostring(wPF, format.mintick) + " · " + str.format_time(time, "dd/MM HH:mm", i_tz)
if wI != 0
    swTxt := "internal " + (wI > 0 ? "bullish" : "bearish") + " · " + str.tostring(wPI, format.mintick) + " · " + str.format_time(time, "dd/MM HH:mm", i_tz)
if wS != 0
    swTxt := "swing " + (wS > 0 ? "bullish" : "bearish") + " · " + str.tostring(wPS, format.mintick) + " · " + str.format_time(time, "dd/MM HH:mm", i_tz)

plotshape(i_conf and not na(phS), "Swing high bevestigd", shape.triangledown, location.abovebar, color.new(t3c, 30), size = size.tiny, display = display.pane)
plotshape(i_conf and not na(plS), "Swing low bevestigd", shape.triangleup, location.belowbar, color.new(t3c, 30), size = size.tiny, display = display.pane)

// ═══ 5. Zones (OB-P / OB-F) met lifecycle ═══════════════════════
var array<Zone> zones = array.new<Zone>()
var int cZP = 0
var int cZF = 0
var int cZx = 0
stName(int st) =>
    st == 0 ? "NIEUW" : st == 1 ? "ACTIEF" : st == 2 ? "GETEST" : st == 3 ? "GEDEELTELIJK" : st == 4 ? "GEBRUIKT" : "ONGELDIG"

hasZone(string id) =>
    bool f = false
    for z in zones
        if z.id == id
            f := true
            break
    f

// Maakt een zone op de candle k bars terug. 1 = gemaakt · 0 = bestond al · −1 = te hoog (overgeslagen)
addZone(string kind, string src, int dir, int k) =>
    float top = dir > 0 ? math.max(open[k], close[k]) : high[k]
    float bot = dir > 0 ? low[k] : math.min(open[k], close[k])
    string id = syminfo.ticker + "-" + timeframe.period + "-" + kind + "-" + str.format_time(time[k], "yyyyMMdd-HHmm", "UTC") + (dir > 0 ? "-L" : "-S")
    int res = 0
    if top - bot <= 0 or top - bot > h_zMaxH * atr
        res := -1
    else if not hasZone(id)
        Zone z = Zone.new(id, kind, src, dir, top, bot, time[k], bar_index, time)
        z.bx := box.new(time[k], top, time, bot, xloc = xloc.bar_time, border_color = na, bgcolor = na, text = "", text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
        zones.push(z)
        res := 1
        if zones.size() > 16
            int idx = 0
            for [i, q] in zones
                if q.st >= 4
                    idx := i
                    break
            Zone old = zones.remove(idx)
            if not na(old.bx)
                old.bx.delete()
    res

// OB-P: extreem van het been sinds de oorsprong van het gebroken pivot; daarvan (≤ 3 bars terug) de laatste tegencandle.
obPOff(int dir, int n) =>
    int m = math.min(math.max(n, 1), 300)
    int kx = na
    float ex = na
    for k = 1 to m
        float v = dir > 0 ? low[k] : high[k]
        if na(ex) or (dir > 0 ? v < ex : v > ex)
            ex := v
            kx := k
    int res = kx
    if not na(kx)
        for j = kx to kx + 3
            if dir > 0 ? close[j] < open[j] : close[j] > open[j]
                res := j
                break
    res

// OB-F: vroegste FVG van de impuls (niet ouder dan het extreem van het been); de laatste tegencandle op of vóór de FVG-start.
obFOff(int dir, int n) =>
    int m = math.min(math.max(n, 1), 300)
    int kx = na
    float ex = na
    for k = 1 to m
        float v = dir > 0 ? low[k] : high[k]
        if na(ex) or (dir > 0 ? v < ex : v > ex)
            ex := v
            kx := k
    int kf = na
    int lim = math.min(h_fvgLook, nz(kx, 1))
    for k = 0 to lim - 1
        bool fvg = dir > 0 ? low[k] > high[k + 2] : high[k] < low[k + 2]
        if fvg and k + 1 <= nz(kx, 0)
            kf := k
    int res = na
    if not na(kf)
        for j = kf + 2 to kf + 6
            if dir > 0 ? close[j] < open[j] : close[j] > open[j]
                res := j
                break
    res

mkZones(int brk, int bB, string src) =>
    int rP = 0
    int rF = 0
    if brk != 0 and not na(bB)
        int d = brk > 0 ? 1 : -1
        int n = bar_index - bB
        int kp = obPOff(d, n)
        if not na(kp)
            rP := addZone("OB-P", src, d, kp)
        int kf = obFOff(d, n)
        if not na(kf)
            rF := addZone("OB-F", src, d, kf)
    [rP, rF]

updZones() =>
    for z in zones
        if z.st < 5 and bar_index > z.cBar
            float hgt = z.top - z.bot
            bool touch = z.dir > 0 ? low <= z.top : high >= z.bot
            if touch and not z.inside
                z.tests += 1
            z.inside := touch
            float p = z.dir > 0 ? (z.top - low) / hgt : (high - z.bot) / hgt
            z.pen := math.max(z.pen, math.max(0.0, math.min(1.0, p)))
            if z.dir > 0 ? close < z.bot : close > z.top
                z.st := 5
                z.why := "close door zone"
            else if bar_index - z.cBar > h_zAge
                z.st := 5
                z.why := "verlopen"
            else if z.st < 4
                z.st := z.pen * 100 >= h_mit ? 4 : z.pen * 100 >= h_mit / 2 ? 3 : z.pen > 0 ? 2 : 1
            if z.st < 4
                z.bx.set_right(time)
            if z.st == 5
                z.bx.delete()

if barstate.isconfirmed
    updZones()
    [p1, f1] = mkZones(bS, bBS, "S")
    [p2, f2] = mkZones(bI, bBI, "I")
    cZP += (p1 == 1 ? 1 : 0) + (p2 == 1 ? 1 : 0)
    cZF += (f1 == 1 ? 1 : 0) + (f2 == 1 ? 1 : 0)
    cZx += (p1 == -1 ? 1 : 0) + (p2 == -1 ? 1 : 0) + (f1 == -1 ? 1 : 0) + (f2 == -1 ? 1 : 0)

// ═══ 5b. CBO-module: box-statemachine met de regels van CBO_0.1 (zonder events en zonder meting) ═══
// 0 GEEN CONTEXT · 1 CONTEXT GELDIG · 2 VORMT · 3 KANDIDAAT · 4 VERZEGELD · 5 BREAKOUT · 6 ACCEPTATIE · 9 MISLUKT · 10 VERLOPEN
cboName(int s) =>
    switch s
        0 => "GEEN CONTEXT"
        1 => "CONTEXT GELDIG"
        2 => "CONSOLIDATIE VORMT"
        3 => "BOX KANDIDAAT"
        4 => "BOX VERZEGELD"
        5 => "BREAKOUT"
        6 => "ACCEPTATIE"
        9 => "MISLUKT"
        10 => "VERLOPEN"
        => "?"

bool cboTF = tfSec == 900 or tfSec == 1800 or tfSec == 3600 or tfSec == 14400
string ctxTF = tfSec <= 1800 ? "240" : "D"
ctxVals() =>
    float e = ta.ema(close, 50)
    float sl = e - e[5]
    [e[1], close[1], sl[1]]
float ctxEma = na
float ctxClose = na
float ctxSlope = na
if i_cbo and cboTF
    [e1, e2, e3] = request.security(syminfo.tickerid, ctxTF, ctxVals(), lookahead = barmerge.lookahead_on)
    ctxEma := e1
    ctxClose := e2
    ctxSlope := e3

float rv  = ta.stdev(math.log(close / close[1]), c_volLen)
float rvP = ta.percentrank(rv, c_volPct)
float er  = math.abs(close - close[c_erLen]) / math.max(math.sum(math.abs(close - close[1]), c_erLen), syminfo.mintick)
float rngB = high - low
bool ctxUp = not na(ctxSlope) and ctxSlope > 0 and ctxClose > ctxEma
bool ctxDn = not na(ctxSlope) and ctxSlope < 0 and ctxClose < ctxEma
string regime = rngB >= c_expMult * atr ? "expansie" : rvP > c_highVol ? "hoge volatiliteit" : er < c_erChaos and rvP > 50 ? "chaotisch" : rvP < c_lowVol ? "lage volatiliteit" : rvP < c_compVol and er < c_erTrend ? "compressie" : er >= c_erTrend and (ctxUp or ctxDn) ? "trend" : "balans"
bool regimeOK = regime == "compressie" or regime == "balans" or regime == "trend" or regime == "lage volatiliteit"
float hhN = ta.highest(high, c_nMin)
float llN = ta.lowest(low, c_nMin)

var int    xSt = 0
var float  xHi = na
var float  xLo = na
var int    xStartT = na
var int    xStartB = na
var int    xN = 0
var int    xTop = 0
var int    xBot = 0
var int    xQuiet = 0
var float  xsHi = na
var float  xsLo = na
var int    xsStartT = na
var int    xsT = na
var int    xsB = na
var int    xsN = 0
var string xId = ""
var int    xDir = 0
var int    xBB = na
var int    xBT = na
var int    xEndT = na
var int    xOut = 0
var int    xRes = 0
var string xLast = "–"
var int cK = 0
var int cS = 0
var int cB = 0
var int cA = 0
var int cF = 0
var int cE = 0
var int cZR = 0

if barstate.isconfirmed and i_cbo and cboTF
    if xSt <= 1 or xSt >= 6
        if regimeOK and (hhN - llN) <= c_wMax * atr
            xSt := 2
            xHi := hhN
            xLo := llN
            xN := c_nMin
            xStartT := time[c_nMin - 1]
            xStartB := bar_index - c_nMin + 1
            xTop := 0
            xBot := 0
            xQuiet := 0
            float ww = hhN - llN
            for i = 0 to c_nMin - 1
                xTop += high[i] >= hhN - c_tol * ww ? 1 : 0
                xBot += low[i] <= llN + c_tol * ww ? 1 : 0
        else
            xSt := regimeOK ? 1 : 0
    else if xSt == 2 or xSt == 3
        float nh = math.max(xHi, high)
        float nl = math.min(xLo, low)
        if (nh - nl) <= c_wMax * atr and xN < c_nMax
            xQuiet := (high <= xHi and low >= xLo) ? xQuiet + 1 : 0
            xHi := nh
            xLo := nl
            xN += 1
            float w2 = xHi - xLo
            xTop += high >= xHi - c_tol * w2 ? 1 : 0
            xBot += low <= xLo + c_tol * w2 ? 1 : 0
            if xSt == 2 and xTop >= c_tMin and xBot >= c_tMin
                xSt := 3
                cK += 1
            if xSt == 3 and xQuiet >= c_nSeal
                // Verzegeling: vanaf hier liggen de grenzen vast
                xSt := 4
                xsHi := xHi
                xsLo := xLo
                xsStartT := xStartT
                xsT := time_close
                xsB := bar_index
                xsN := xN
                xId := syminfo.ticker + ":" + timeframe.period + ":" + str.tostring(xStartT) + ":" + str.tostring(xsT)
                xDir := 0
                xRes := 0
                xEndT := na
                cS += 1
        else
            xSt := 1
    else if xSt == 4
        bool up = close > xsHi
        bool dn = close < xsLo
        float body = math.abs(close - open)
        float outB = up ? close - math.max(open, xsHi) : dn ? math.min(open, xsLo) - close : 0
        if (up or dn) and body > 0 and outB / body >= c_body
            xSt := 5
            xDir := up ? 1 : -1
            xBB := bar_index
            xBT := time
            xOut := 1
            cB += 1
        else if bar_index - xsB > c_expiry * xsN
            xSt := 10
            xRes := 2
            xEndT := time
            cE += 1
            xLast := "verlopen zonder breakout · " + str.format_time(time, "dd/MM HH:mm", i_tz)
    else if xSt == 5
        if xDir == 1 ? close < xsHi : close > xsLo
            xSt := 9
            xRes := -1
            xEndT := time
            cF += 1
            xLast := "breakout " + (xDir == 1 ? "↑" : "↓") + " mislukt (terug in box) · " + str.format_time(time, "dd/MM HH:mm", i_tz)
        else
            xOut += 1
            if xOut >= c_accK
                xSt := 6
                xRes := 1
                xEndT := time
                cA += 1
                xLast := "acceptatie " + (xDir == 1 ? "↑" : "↓") + " · " + str.format_time(time, "dd/MM HH:mm", i_tz)
                // OB-R: laatste tegencandle binnen de box, vóór de breakout-candle
                int kr = na
                for j = bar_index - xBB + 1 to bar_index - xStartB
                    if xDir > 0 ? close[j] < open[j] : close[j] > open[j]
                        kr := j
                        break
                if not na(kr)
                    int rr = addZone("OB-R", "C", xDir, kr)
                    cZR += rr == 1 ? 1 : 0
                    cZx += rr == -1 ? 1 : 0

// Box tekenen: de laatste verzegelde box (kleur = uitkomst) en een eventuele box die nu vormt (gestippeld)
var box xBxS = na
var box xBxF = na
var label xLb = na
if barstate.islast
    xBxS.delete()
    xBxF.delete()
    xLb.delete()
    if i_cbo and cboTF
        if not na(xsT) and bar_index - xsB < 400
            color cc = xRes == 1 ? (xDir > 0 ? cBull : cBear) : xRes == -1 ? cAmb : t3c
            int tEnd = xSt == 4 ? time : xSt == 5 ? time : nz(xEndT, time)
            xBxS := box.new(xsStartT, xsHi, tEnd, xsLo, xloc = xloc.bar_time, border_color = color.new(cc, 30), border_width = 1, bgcolor = color.new(cc, 92))
            string res = xSt == 4 ? "VERZEGELD" : xSt == 5 ? "BREAKOUT " + (xDir > 0 ? "↑" : "↓") : xRes == 1 ? "ACCEPTATIE " + (xDir > 0 ? "↑" : "↓") : xRes == -1 ? "MISLUKT" : "VERLOPEN"
            xLb := label.new(xsStartT, xsHi, "CBO · " + res, xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(cc, 100), textcolor = cc, size = size.tiny, tooltip = "Box-ID " + xId + " · " + str.tostring(xsN) + " bars · regels CBO_0.1 (zonder eventblokkade)")
        if xSt == 2 or xSt == 3
            xBxF := box.new(xStartT, xHi, time, xLo, xloc = xloc.bar_time, border_color = color.new(t3c, 40), border_style = line.style_dashed, border_width = 1, bgcolor = na)

// ═══ 5c. Referentielijnen vanaf de echte wick (PDH/PDL/PWH/PWL, optioneel opens) ═══
bool newD = timeframe.change("D")
bool newW = timeframe.change("W")
var float dH = na
var int   dHT = na
var float dL = na
var int   dLT = na
var float wH = na
var int   wHT = na
var float wL = na
var int   wLT = na
var float rPDH = na
var int   rPDHt = na
var int   rPDHx = na
var float rPDL = na
var int   rPDLt = na
var int   rPDLx = na
var float rPWH = na
var int   rPWHt = na
var int   rPWHx = na
var float rPWL = na
var int   rPWLt = na
var int   rPWLx = na
var float rDO = na
var int   rDOt = na
var float rWO = na
var int   rWOt = na
if newD
    rPDH := dH
    rPDHt := dHT
    rPDHx := na
    rPDL := dL
    rPDLt := dLT
    rPDLx := na
    dH := high
    dHT := time
    dL := low
    dLT := time
    rDO := open
    rDOt := time
else
    if na(dH) or high > dH
        dH := high
        dHT := time
    if na(dL) or low < dL
        dL := low
        dLT := time
if newW
    rPWH := wH
    rPWHt := wHT
    rPWHx := na
    rPWL := wL
    rPWLt := wLT
    rPWLx := na
    wH := high
    wHT := time
    wL := low
    wLT := time
    rWO := open
    rWOt := time
else
    if na(wH) or high > wH
        wH := high
        wHT := time
    if na(wL) or low < wL
        wL := low
        wLT := time
if barstate.isconfirmed
    if not na(rPDH) and na(rPDHx) and high > rPDH
        rPDHx := time
    if not na(rPDL) and na(rPDLx) and low < rPDL
        rPDLx := time
    if not na(rPWH) and na(rPWHx) and high > rPWH
        rPWHx := time
    if not na(rPWL) and na(rPWLx) and low < rPWL
        rPWLx := time

dAtrV() =>
    float a = ta.atr(14)
    a[1]
float dAtr = na
if i_refs
    dAtr := request.security(syminfo.tickerid, "D", dAtrV(), lookahead = barmerge.lookahead_on)

refAdd(array<string> nm, array<float> px, array<int> t0, array<int> tx, string n, float p, int t, int x) =>
    nm.push(n)
    px.push(p)
    t0.push(t)
    tx.push(x)

var array<line>   refLn = array.new<line>()
var array<label>  refLb = array.new<label>()
var array<string> refNm = array.new<string>()
var array<float>  refPx = array.new<float>()
if barstate.islast
    for l in refLn
        l.delete()
    for b in refLb
        b.delete()
    refLn.clear()
    refLb.clear()
    refNm.clear()
    refPx.clear()
    if i_refs
        array<string> nm = array.new<string>()
        array<float>  px = array.new<float>()
        array<int>    t0 = array.new<int>()
        array<int>    tx = array.new<int>()
        if tfSec < 86400
            refAdd(nm, px, t0, tx, "PDH", rPDH, rPDHt, rPDHx)
            refAdd(nm, px, t0, tx, "PDL", rPDL, rPDLt, rPDLx)
            if i_refOpen
                refAdd(nm, px, t0, tx, "D Open", rDO, rDOt, na)
        if tfSec < 604800
            refAdd(nm, px, t0, tx, "PWH", rPWH, rPWHt, rPWHx)
            refAdd(nm, px, t0, tx, "PWL", rPWL, rPWLt, rPWLx)
            if i_refOpen
                refAdd(nm, px, t0, tx, "W Open", rWO, rWOt, na)
        array<float> dist = array.new<float>()
        array<int>   idx = array.new<int>()
        for i = 0 to nm.size() - 1
            float p = px.get(i)
            if not na(p) and not na(t0.get(i)) and (na(tx.get(i)) or i_refTaken) and (na(dAtr) or math.abs(p - close) <= r_dist * dAtr)
                dist.push(math.abs(p - close) + (na(tx.get(i)) ? 0 : 1e9))
                idx.push(i)
        if idx.size() > 0
            array<int> ord = dist.sort_indices()
            int railT = time + 4 * tfSec * 1000
            for k = 0 to math.min(r_max, ord.size()) - 1
                int i = idx.get(ord.get(k))
                float p = px.get(i)
                bool taken = not na(tx.get(i))
                color lc = taken ? color.new(t3c, 60) : color.new(t2c, 25)
                refLn.push(line.new(t0.get(i), p, taken ? tx.get(i) : railT, p, xloc = xloc.bar_time, color = lc, style = taken ? line.style_dotted : line.style_solid, width = 1))
                refLb.push(label.new(railT, p, nm.get(i) + (taken ? " ✓" : ""), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(t3c, 100), textcolor = taken ? t3c : t2c, size = size.tiny, tooltip = nm.get(i) + " " + str.tostring(p, format.mintick) + " · start op de candle die het niveau maakte (" + str.format_time(t0.get(i), "dd/MM HH:mm", i_tz) + ")" + (taken ? " · geraakt " + str.format_time(tx.get(i), "dd/MM HH:mm", i_tz) : "")))
                if not taken
                    refNm.push(nm.get(i))
                    refPx.push(p)

// Eerste niet-geraakte referentie in richting d vanaf prijs p (alle kandidaten, niet alleen de getoonde)
firstRef(int d, float p) =>
    float best = na
    string bn = ""
    float[] ys = array.from(tfSec < 86400 and na(rPDHx) ? rPDH : na, tfSec < 86400 and na(rPDLx) ? rPDL : na, tfSec < 604800 and na(rPWHx) ? rPWH : na, tfSec < 604800 and na(rPWLx) ? rPWL : na)
    string[] ns = array.from("PDH", "PDL", "PWH", "PWL")
    for i = 0 to ys.size() - 1
        float y = ys.get(i)
        if not na(y) and (d == 1 ? y > p : y < p) and (na(best) or math.abs(y - p) < math.abs(best - p))
            best := y
            bn := ns.get(i)
    [best, bn]

// Samenhang (beschrijvend, geen signaal): klopt de structuur met richting d?
alignTxt(int d) =>
    float pd = pdOf(lS)
    bool locOk = na(pd) ? false : d == 1 ? pd < 55 : pd > 45
    bool zOk = false
    for z in zones
        if z.dir == d and z.st >= 1 and z.st <= 3 and z.top >= xsLo - atr and z.bot <= xsHi + atr
            zOk := true
    (lS.dir == d ? "✓" : "✕") + " swing · " + (lI.dir == d ? "✓" : "✕") + " internal · " + (na(pd) ? "?" : locOk ? "✓" : "✕") + (d == 1 ? " niet premium" : " niet discount") + " · " + (zOk ? "✓" : "✕") + " zone bij box"

// Zichtbaarheid: per richting alleen de dichtstbijzijnde actieve zones; gebruikte zones alleen vervaagd in Expanded.
var array<Zone> zShown = array.new<Zone>()
if barstate.islast
    zShown.clear()
    for z in zones
        z.vis := false
    for d in array.from(1, -1)
        array<float> dist = array.new<float>()
        array<Zone> cand = array.new<Zone>()
        for z in zones
            if z.dir == d and z.st >= 1 and z.st <= 3 and (i_zVar == "Alle" or z.kind == i_zVar)
                cand.push(z)
                dist.push(math.abs(close - (z.top + z.bot) / 2))
        if cand.size() > 0 and i_zShow > 0
            array<int> ord = dist.sort_indices()
            for k = 0 to math.min(i_zShow, ord.size()) - 1
                Zone zz = cand.get(ord.get(k))
                zz.vis := true
                zShown.push(zz)
    for z in zones
        if z.st < 5
            color c = z.dir > 0 ? cBull : cBear
            bool vis = i_drawZ and z.vis
            bool faded = i_drawZ and z.st == 4 and i_mode == "Expanded" and (i_zVar == "Alle" or z.kind == i_zVar)
            z.bx.set_bgcolor(vis ? color.new(c, 86) : faded ? color.new(c, 95) : na)
            z.bx.set_border_color(vis ? color.new(c, 50) : faded ? color.new(c, 85) : na)
            z.bx.set_text(vis or faded ? z.kind + " · " + stName(z.st) : "")
            z.bx.set_text_color(vis ? color.new(c, 20) : color.new(c, 70))

// ═══ 6. Equilibrium van de swingrange ═══════════════════════════
var line eqL = na
var label eqLb = na
if barstate.islast
    eqL.delete()
    eqLb.delete()
    if i_eq and not na(lS.tTop) and not na(lS.tBot) and not na(lS.hi) and not na(lS.lo) and lS.tTop > lS.tBot
        float eq = (lS.tTop + lS.tBot) / 2
        eqL := line.new(math.min(lS.hi.oTime, lS.lo.oTime), eq, time, eq, xloc = xloc.bar_time, color = color.new(t3c, 40), style = line.style_dotted, width = 1)
        eqLb := label.new(time, eq, "EQ 50%", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(t3c, 100), textcolor = t3c, size = size.tiny)

// ═══ 7. Kaart ═══════════════════════════════════════════════════
var table tb = table.new(i_pos == "Rechtsboven" ? position.top_right : i_pos == "Rechtsonder" ? position.bottom_right : i_pos == "Linksboven" ? position.top_left : position.bottom_left, 2, 40, border_width = 0, frame_width = 0)
row2(int r, string a, string b, color ca, color cbb, string tip = "", string sz = size.small) =>
    tb.cell(0, r, a, text_color = ca, text_size = sz, text_halign = text.align_left, bgcolor = bgc, tooltip = tip)
    tb.cell(1, r, b, text_color = cbb, text_size = sz, text_halign = text.align_left, bgcolor = bgc, tooltip = tip)
row1(int r, string a, color ca, string tip = "", string sz = size.small) =>
    tb.cell(0, r, a, text_color = ca, text_size = sz, text_halign = text.align_left, bgcolor = bgc, tooltip = tip)
    tb.merge_cells(0, r, 1, r)
dirTxt(int d) =>
    d == 1 ? "Bullish" : d == -1 ? "Bearish" : "Neutraal"
stgTxt(int g) =>
    g == 1 ? "mogelijke shift" : g == 2 ? "shift bevestigd" : g == 3 ? "continuation" : g == 4 ? "verzwakt" : "geen structuur"
pdTxt(float p) =>
    na(p) ? "–" : (p > 55 ? "premium " : p < 45 ? "discount " : "equilibrium ") + str.tostring(p, "0") + "%"
dirCol(int d) =>
    d == 1 ? cBull : d == -1 ? cBear : t2c
lvlTxt(Lvl s) =>
    dirTxt(s.dir) + " · " + stgTxt(s.stage) + (s.lastEv != "" ? " · " + s.lastEv + " " + str.format_time(s.lastEvTime, "dd/MM HH:mm", i_tz) : "")

const string TIP_STG = "Mogelijke shift = eerste close-break tegen de richting (CHoCH) · shift bevestigd = eerste BoS daarna · continuation = volgende BoS · verzwakt = sweep aan de trendzijde (mislukte voortzetting). Alles op candle-close."
if barstate.islast
    tb.clear(0, 0, 1, 39)
    int r = 0
    if i_spacer > 0 and (i_pos == "Rechtsboven" or i_pos == "Linksboven")
        for k = 0 to i_spacer - 1
            tb.cell(0, r, " ", text_size = size.small)
            r += 1
    row1(r, syminfo.ticker + " · " + timeframe.period + " · TECHNISCHE STRUCTUUR", t1c, "", size.normal)
    r += 1
    row1(r, "ONDERZOEKSVERSIE — GEEN BEWEZEN EDGE · geen macro, geen signalen", cAmb, "Alle drempels zijn hypothesen (contract 0.1). Bias 5.0 blijft het hoofdoordeel.", size.tiny)
    r += 1
    row2(r, "Swing", lvlTxt(lS), t2c, dirCol(lS.dir), TIP_STG)
    r += 1
    row2(r, "Internal", lvlTxt(lI), t2c, dirCol(lI.dir), TIP_STG)
    r += 1
    if i_mode != "Minimal"
        row2(r, "Fractal", lvlTxt(lF), t2c, dirCol(lF.dir), TIP_STG)
        r += 1
    row2(r, "Locatie", "swingrange: " + pdTxt(pdOf(lS)), t2c, t1c, "Dealing range = laatste bevestigde swing high tot swing low (meegeschoven met het extreem daarna). <45% discount · 45–55% equilibrium · >55% premium.")
    r += 1
    if i_cbo
        string cboTxt = not cboTF ? "niet actief op " + timeframe.period + " (CBO: 15m/30m/1H/4H)" : cboName(xSt) + (xSt == 2 or xSt == 3 ? " · " + str.tostring(xN) + " bars" : xSt == 4 or xSt == 5 ? " · " + str.tostring(xsLo, format.mintick) + "–" + str.tostring(xsHi, format.mintick) : "") + " · regime " + regime
        row2(r, "CBO", cboTxt, t2c, cboTF and xSt == 5 ? (xDir > 0 ? cBull : cBear) : t1c, "Regels en drempels van CBO_0.1, zonder eventblokkade (komt in fase 3). Laatste afloop: " + xLast)
        r += 1
        if i_mode != "Minimal" and cboTF
            if xSt == 4
                int sd = lS.dir != 0 ? lS.dir : 1
                row2(r, "Samenhang", "swingzijde " + (sd > 0 ? "↑" : "↓") + ": " + alignTxt(sd), t2c, t1c, "Beschrijvend, geen signaal. Box is verzegeld; dit is hoe de structuur ervoor staat aan de swingzijde.")
                r += 1
            else if xSt == 5 or (xRes == 1 and bar_index - xBB <= 10)
                [fr, frn] = firstRef(xDir, close)
                float bw = xsHi - xsLo
                string room = na(fr) or bw <= 0 ? " · geen referentie in deze richting" : " · eerste referentie " + frn + " op " + str.tostring(math.abs(fr - close) / bw, "0.0") + "× boxbreedte"
                row2(r, "Samenhang", "breakout " + (xDir > 0 ? "↑" : "↓") + ": " + alignTxt(xDir) + room, t2c, t1c, "Beschrijvend, geen signaal. Poorten (WATCH/ARMED/CONFIRMED) komen in fase 3.")
                r += 1
            row2(r, "Laatste box", xLast, t2c, t1c, "Afloop van de laatst verzegelde box.")
            r += 1
    if i_refs and i_mode != "Minimal"
        string rt = ""
        for k = 0 to refNm.size() - 1
            if refNm.size() > 0
                rt += (k > 0 ? " · " : "") + refNm.get(k) + " " + str.tostring(refPx.get(k), format.mintick) + " (" + str.tostring((refPx.get(k) - close) / atr, "+0.0;-0.0") + " ATR)"
        row2(r, "Referenties", rt == "" ? "geen ongeraakt niveau binnen " + str.tostring(r_dist) + "× daily ATR" : rt, t2c, t1c, "Vorige dag/week high/low vanaf de candle die het niveau maakte; geraakte niveaus verdwijnen.")
        r += 1
    if i_mode != "Minimal"
        if i_rowD and tfSec < 86400
            row2(r, "Daily swing", na(dDir) ? "laden…" : dirTxt(dDir) + " · " + stgTxt(dStg) + " · " + pdTxt(dPd), t2c, na(dDir) ? t3c : dirCol(dDir), "Laatste gesloten dagcandle. Technische oriëntatie, geen macrobias.")
            r += 1
        if i_rowH4 and tfSec < 14400
            row2(r, "4H swing", na(h4Dir) ? "laden…" : dirTxt(h4Dir) + " · " + stgTxt(h4Stg) + " · " + pdTxt(h4Pd), t2c, na(h4Dir) ? t3c : dirCol(h4Dir), "Laatste gesloten 4H-candle. Technische oriëntatie, geen macrobias.")
            r += 1
        int nb = 0
        int ns = 0
        for z in zones
            if z.st >= 1 and z.st <= 3
                nb += z.dir > 0 ? 1 : 0
                ns += z.dir < 0 ? 1 : 0
        row2(r, "Zones", str.tostring(nb) + " bullish · " + str.tostring(ns) + " bearish actief" + (zShown.size() > 0 ? " · dichtst: " + zShown.get(0).kind + " " + str.tostring(zShown.get(0).bot, format.mintick) + "–" + str.tostring(zShown.get(0).top, format.mintick) + " (" + stName(zShown.get(0).st) + ")" : ""), t2c, t1c, "Zone verdwijnt na " + str.tostring(h_mit, "0") + "% mitigatie (GEBRUIKT) of bij een close door de zone (ONGELDIG).")
        r += 1
        row2(r, "Laatste sweep", swTxt, t2c, t1c, "Wick door een bevestigd niveau, close terug binnen (absorptie). Context, geen entry.")
        r += 1
    if i_mode == "Expanded"
        row1(r, "— Onderzoek —", t3c, "", size.tiny)
        r += 1
        row2(r, "Tellingen", "S BoS " + str.tostring(lS.nBos) + " · CHoCH " + str.tostring(lS.nChoch) + " · sweep " + str.tostring(lS.nSweep) + " | I " + str.tostring(lI.nBos) + "/" + str.tostring(lI.nChoch) + "/" + str.tostring(lI.nSweep) + " | F " + str.tostring(lF.nBos) + "/" + str.tostring(lF.nChoch) + "/" + str.tostring(lF.nSweep), t3c, t2c, "BoS / CHoCH / sweep per laag over de geladen historie.", size.tiny)
        r += 1
        row2(r, "Zones gemaakt", "OB-P " + str.tostring(cZP) + " · OB-F " + str.tostring(cZF) + " · OB-R " + str.tostring(cZR) + " · te hoog overgeslagen " + str.tostring(cZx), t3c, t2c, "", size.tiny)
        r += 1
        if i_cbo and cboTF
            row2(r, "CBO-tellingen", "kandidaat " + str.tostring(cK) + " · verzegeld " + str.tostring(cS) + " · breakout " + str.tostring(cB) + " · acceptatie " + str.tostring(cA) + " · mislukt " + str.tostring(cF) + " · verlopen " + str.tostring(cE), t3c, t2c, "Retrospectief over de geladen historie; geen meting, geen edgeclaim.", size.tiny)
            r += 1
        for z in zShown
            row2(r, z.kind + (z.dir > 0 ? " ↑" : " ↓"), stName(z.st) + " · mitigatie " + str.tostring(z.pen * 100, "0") + "% · tests " + str.tostring(z.tests) + " · bron " + z.src, t3c, t2c, z.id, size.tiny)
            r += 1
        row2(r, "Hypothesen", "pivots S" + str.tostring(h_lenS) + "/I" + str.tostring(h_lenI) + "/F" + str.tostring(h_lenF) + " · buffer " + str.tostring(h_buf) + " ATR · sweepwick ≥ " + str.tostring(h_swWick * 100, "0") + "% · mitigatie " + str.tostring(h_mit, "0") + "% · verval " + str.tostring(h_zAge) + " bars", t3c, t2c, "", size.tiny)
        r += 1
        row1(r, "Pivot bevestigd na " + str.tostring(h_lenS) + " (swing) / " + str.tostring(h_lenI) + " (internal) gesloten bars; bruikbaar vanaf de bar erna.", t3c, "", size.tiny)
        r += 1

// ═══ 8. Meetwaarden in het datavenster (geen lijnen op de chart) ═══
plot(lS.dir, "Swing richting", display = display.data_window)
plot(lS.stage, "Swing stage", display = display.data_window)
plot(lI.dir, "Internal richting", display = display.data_window)
plot(lI.stage, "Internal stage", display = display.data_window)
plot(lF.dir, "Fractal richting", display = display.data_window)
plot(lS.nBos, "S BoS", display = display.data_window)
plot(lS.nChoch, "S CHoCH", display = display.data_window)
plot(lS.nSweep, "S sweeps", display = display.data_window)
plot(lI.nBos, "I BoS", display = display.data_window)
plot(lI.nChoch, "I CHoCH", display = display.data_window)
plot(lI.nSweep, "I sweeps", display = display.data_window)
plot(lF.nBos, "F BoS", display = display.data_window)
plot(lF.nChoch, "F CHoCH", display = display.data_window)
plot(lF.nSweep, "F sweeps", display = display.data_window)
plot(cZP, "Zones OB-P", display = display.data_window)
plot(cZF, "Zones OB-F", display = display.data_window)
plot(cZx, "Zones overgeslagen", display = display.data_window)
plot(pdOf(lS), "Swing PD %", display = display.data_window)
plot(h4Dir, "4H richting", display = display.data_window)
plot(dDir, "D richting", display = display.data_window)
plot(cZR, "Zones OB-R", display = display.data_window)
plot(xSt, "CBO state", display = display.data_window)
plot(cK, "CBO kandidaten", display = display.data_window)
plot(cS, "CBO verzegeld", display = display.data_window)
plot(cB, "CBO breakouts", display = display.data_window)
plot(cA, "CBO acceptatie", display = display.data_window)
plot(cF, "CBO mislukt", display = display.data_window)
plot(cE, "CBO verlopen", display = display.data_window)
plot(rPDH, "PDH", display = display.data_window)
plot(rPDL, "PDL", display = display.data_window)
plot(bar_index + 1, "Bars geladen", display = display.data_window)
