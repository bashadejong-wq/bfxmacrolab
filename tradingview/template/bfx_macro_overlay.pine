//@version=6
// BFX-MACRO-OVERLAY
// Dit script wordt automatisch vervangen door tradingview/bfx-tv.mjs. Handmatige wijzigingen gaan verloren.
// Versie: {{VERSION}}
indicator("BFX Macro Overlay", shorttitle = "BFX Macro", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 200)

// ─── Instellingen ───────────────────────────────────────────────
const string GV = "Weergave"
const string GC = "Kleuren"
i_ccys      = input.string("", "Paar (leeg = automatisch)", tooltip = "Bijv. EUR,USD. Leeg = basis- en noteringsvaluta van de chart.", group = GV)
i_minImpact = input.int(2, "Minimale impact events", minval = 1, maxval = 3, tooltip = "1 = laag, 2 = medium, 3 = hoog", group = GV)
i_pastDays  = input.int(7, "Afgelopen events tonen (dagen)", minval = 0, maxval = 30, group = GV)
i_lines     = input.bool(true, "Verticale eventlijnen", group = GV)
i_labels    = input.bool(true, "Eventlabels", group = GV)
i_zones     = input.bool(true, "Risicozones rond hoge-impact events", group = GV)
i_zoneBef   = input.int(30, "Zone: minuten vóór event", minval = 0, maxval = 720, group = GV)
i_zoneAft   = input.int(60, "Zone: minuten na event", minval = 0, maxval = 1440, group = GV)
i_table     = input.bool(true, "Overzichtstabel", group = GV)
i_rows      = input.int(8, "Max. events in tabel", minval = 0, maxval = 20, group = GV)
i_tablePos  = input.string("Rechtsboven", "Positie tabel", options = ["Rechtsboven", "Rechtsonder", "Linksboven", "Linksonder"], group = GV)
i_staleDays = input.int(3, "Waarschuw als data ouder is dan (dagen)", minval = 1, maxval = 30, group = GV)
c_high      = input.color(#E5484D, "Hoge impact", group = GC)
c_med       = input.color(#F5A524, "Medium impact", group = GC)
c_low       = input.color(#8B8D98, "Lage impact", group = GC)
c_bull      = input.color(#30A46C, "Bullish", group = GC)
c_bear      = input.color(#E5484D, "Bearish", group = GC)

// ─── Datatypes ──────────────────────────────────────────────────
type MacroEvent
    int    t
    string ccy
    int    impact
    string title
    string stats
    string detail

// BIAS 5.0 per paar (mirror_bias50_paar). idx > 0 = basisvaluta sterker.
type PairBias
    string basis
    string quote
    float  idx
    string lbl
    string tekst
    string emmer
    float  z
    string bevestiging

// BIAS 5.0 per valuta (mirror_bias50 + mirror_bias50_samenvatting)
type CcyBias
    string ccy
    float  idx
    string lbl
    string zekerheid
    bool   conflict
    string bevestiging
    string kantelpunt
    string samenvatting

var array<MacroEvent> events = array.new<MacroEvent>()
var array<PairBias>   pairs  = array.new<PairBias>()
var array<CcyBias>    ccyb   = array.new<CcyBias>()

addEv(int t, string ccy, int impact, string title, string stats, string detail) =>
    events.push(MacroEvent.new(t, ccy, impact, title, stats, detail))

addPair(string basis, string quote, float idx, string lbl, string tekst, string emmer, float z, string bevestiging) =>
    pairs.push(PairBias.new(basis, quote, idx, lbl, tekst, emmer, z, bevestiging))

addCcy(string ccy, float idx, string lbl, string zekerheid, bool conflict, string bevestiging, string kantelpunt, string samenvatting) =>
    ccyb.push(CcyBias.new(ccy, idx, lbl, zekerheid, conflict, bevestiging, kantelpunt, samenvatting))

// ═══ DATA-START (automatisch gegenereerd) ═══
{{DATA}}
// ═══ DATA-EINDE ═══

// ─── Helpers ────────────────────────────────────────────────────
impactColor(int imp) =>
    imp >= 3 ? c_high : imp == 2 ? c_med : c_low

// Light-labels krijgen een lichtere tint; Neutral is grijs (binnen ±15 geen richting).
biasColor(string lbl) =>
    string s = str.lower(lbl)
    color base = str.contains(s, "bull") ? c_bull : str.contains(s, "bear") ? c_bear : color.gray
    str.contains(s, "light") ? color.new(base, 35) : base

flipLabel(string lbl) =>
    str.replace_all(str.replace_all(str.replace_all(lbl, "Bullish", "#TMP#"), "Bearish", "Bullish"), "#TMP#", "Bearish")

fmtIdx(float v) =>
    (v > 0 ? "+" : "") + str.tostring(v, "0.0")

chartPair() =>
    string s = str.upper(str.replace_all(i_ccys, " ", ""))
    string b = syminfo.basecurrency
    string q = syminfo.currency
    if s != ""
        array<string> parts = str.split(s, ",")
        b := parts.size() > 1 ? parts.get(0) : ""
        q := parts.size() > 1 ? parts.get(1) : parts.get(0)
    [b, q]

// Geeft ",EUR,USD," terug zodat we op ",CCY," kunnen zoeken.
activeCcys() =>
    [b, q] = chartPair()
    "," + (b == "" or b == q ? q : b + "," + q) + ","

isRelevant(string ccy, string ccys) =>
    ccy == "ALL" or str.contains(ccys, "," + ccy + ",")

// Zoekt het paar; staat het andersom in de data (bv. USDEUR), dan ook gevonden (aanroeper keert om).
findPair(string b, string q) =>
    PairBias found = na
    for p in pairs
        if p.basis == b and p.quote == q
            found := p
            break
    if na(found)
        for p in pairs
            if p.basis == q and p.quote == b
                found := p
                break
    found

findCcy(string c) =>
    CcyBias found = na
    for x in ccyb
        if x.ccy == c
            found := x
            break
    found

tablePos() =>
    switch i_tablePos
        "Rechtsonder" => position.bottom_right
        "Linksboven"  => position.top_left
        "Linksonder"  => position.bottom_left
        => position.top_right

// ─── Eventlijnen en labels ──────────────────────────────────────
atrv  = ta.atr(14)
hiRef = ta.highest(high, 50)
loRef = ta.lowest(low, 50)

var array<line>  evLines  = array.new<line>()
var array<label> evLabels = array.new<label>()
var array<box>   evZones  = array.new<box>()

if barstate.islast
    for l in evLines
        l.delete()
    evLines.clear()
    for lb in evLabels
        lb.delete()
    evLabels.clear()
    for bx in evZones
        bx.delete()
    evZones.clear()

    string ccys  = activeCcys()
    int    fromT = timenow - i_pastDays * 86400000
    int    k     = 0
    for e in events
        if e.impact >= i_minImpact and e.t >= fromT and isRelevant(e.ccy, ccys)
            color col  = impactColor(e.impact)
            bool  past = e.t < timenow
            // Risicozone: hier geen nieuwe posities openen (spread en slippage rond hoge-impact events)
            if i_zones and e.impact >= 3
                evZones.push(box.new(e.t - i_zoneBef * 60000, hiRef + atrv * 3, e.t + i_zoneAft * 60000, loRef - atrv * 3, xloc = xloc.bar_time, border_width = 0, bgcolor = color.new(c_high, past ? 94 : 88)))
            if i_lines
                evLines.push(line.new(e.t, close, e.t, close + atrv, xloc = xloc.bar_time, extend = extend.both, color = color.new(col, past ? 70 : 35), style = line.style_dotted, width = 1))
            if i_labels
                float  y    = hiRef + atrv * (0.6 + 0.9 * (k % 3))
                string whenTxt = str.format_time(e.t, "EEE dd/MM HH:mm", syminfo.timezone)
                string tip  = e.ccy + " · " + whenTxt + "\n" + e.title + "\n" + e.stats + (e.detail != "" ? "\n\n" + e.detail : "")
                evLabels.push(label.new(e.t, y, e.ccy + " " + e.title, xloc = xloc.bar_time, yloc = yloc.price, color = color.new(col, past ? 75 : 15), textcolor = color.white, style = label.style_label_down, size = size.small, tooltip = tip))
            k += 1

// ─── Overzichtstabel ────────────────────────────────────────────
const int MAX_ROWS = 40
var table tbl = table.new(tablePos(), 3, MAX_ROWS, bgcolor = color.new(#111318, 8), border_color = color.new(#2A2D35, 0), border_width = 1, frame_color = color.new(#2A2D35, 0), frame_width = 1)

cellL(int col, int row, string txt, color tc, string tip = "", color bg = na) =>
    tbl.cell(col, row, txt, text_color = tc, text_size = size.small, text_halign = text.align_left, tooltip = tip, bgcolor = bg)

if barstate.islast and i_table
    tbl.clear(0, 0, 2, MAX_ROWS - 1)
    [cb, cq]    = chartPair()
    string ccys = activeCcys()
    string upd  = str.format_time(GENERATED, "dd/MM HH:mm", syminfo.timezone)
    color  warn = color.new(c_bear, 20)
    int    r    = 0

    cellL(0, r, "BFX Macro", color.white)
    cellL(1, r, DATA_LABEL, color.white)
    cellL(2, r, "bijgewerkt " + upd, color.silver)
    r += 1

    if timenow - GENERATED > i_staleDays * 86400000
        cellL(0, r, "⚠ Verouderd", color.white, "", warn)
        cellL(1, r, "Indicator niet bijgewerkt", color.white, "", warn)
        cellL(2, r, "laatste update " + upd, color.white, "", warn)
        r += 1

    // BIAS 5.0 voor dit paar
    if BIAS_DATUM > 0
        string bDate = str.format_time(BIAS_DATUM, "dd/MM", "UTC")
        if timenow - BIAS_DATUM > i_staleDays * 86400000
            cellL(0, r, "⚠ BIAS oud", color.white, "", warn)
            cellL(1, r, "BIAS 5.0-data van " + bDate, color.white, "", warn)
            cellL(2, r, BIAS_VERSIE, color.white, "", warn)
            r += 1

        PairBias p = findPair(cb, cq)
        if not na(p)
            bool   inv    = p.basis != cb
            float  pIdx   = inv ? -p.idx : p.idx
            string pLabel = inv ? flipLabel(p.lbl) : p.lbl
            // BIAS 5.0-regel: binnen ±15 geen actieve richting, ongeacht het label
            bool   neutral = math.abs(pIdx) < 15 or str.contains(str.lower(pLabel), "neutral")
            cellL(0, r, "BIAS " + cb + cq, color.white, "BIAS 5.0 " + BIAS_VERSIE + " · " + bDate)
            cellL(1, r, fmtIdx(pIdx) + " · " + pLabel, neutral ? color.gray : biasColor(pLabel), p.tekst)
            cellL(2, r, "gelopen " + p.emmer + " (z " + str.tostring(p.z, "0.00") + ")", color.silver, "Hoe ver de koers al in de richting van de bias is gelopen, in standaardafwijkingen. 'tegen' = koers liep tegen de bias in.")
            r += 1
            cellL(0, r, neutral ? "geen richting" : "richting", neutral ? color.gray : color.white)
            cellL(1, r, neutral ? "binnen ±15: geen kant kiezen" : p.tekst, neutral ? color.gray : color.silver, p.tekst)
            cellL(2, r, p.bevestiging != "" ? p.bevestiging : "", color.silver, "Strategiebevestiging")
            r += 1

        for c in array.from(cb, cq)
            CcyBias x = findCcy(c)
            if not na(x) and r < MAX_ROWS
                string info = "zekerheid " + x.zekerheid + (x.conflict ? " · ⚠ KCFI max 25%" : "")
                string tip  = x.samenvatting + (x.kantelpunt != "" ? "\n\n" + x.kantelpunt : "") + (x.bevestiging != "" ? "\n\nStrategie: " + x.bevestiging : "")
                cellL(0, r, c, color.white, tip)
                cellL(1, r, fmtIdx(x.idx) + " · " + x.lbl, biasColor(x.lbl), tip)
                cellL(2, r, info, x.conflict ? c_bear : color.silver, tip)
                r += 1

    // Komende events
    int shown = 0
    for e in events
        if shown < i_rows and r < MAX_ROWS and e.t >= timenow and e.impact >= i_minImpact and isRelevant(e.ccy, ccys)
            cellL(0, r, str.format_time(e.t, "EEE dd/MM HH:mm", syminfo.timezone), color.silver)
            cellL(1, r, e.ccy + " " + e.title, impactColor(e.impact), e.detail)
            cellL(2, r, e.stats, color.silver, e.detail)
            shown += 1
            r += 1
