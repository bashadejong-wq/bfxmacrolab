    addCcy("AUD", -8.4323, na, na, "Neutral", "laag", false, "tegengesteld", "Dichtstbijzijnde labelgrens: −15 (Neutral naar Light Bearish), 6,57 punten lager.", "AUD: index −8,43 (Neutral); zekerheid laag. Meeste steun: A5 2-jaarsrente minus actuele inflatie (+3,68), A4t Toon centrale bank (+2,88), B3 Paaroordelen (V1) (+2,58). Meeste druk: A3w Werkloosheidstrend (−8,00), B1 Banken (−4,15), B2 Cijferverrassingen (−3,24).")
