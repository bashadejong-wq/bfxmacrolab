//@version=6
// BFX-MACRO-OVERLAY
// Dit script wordt automatisch vervangen door tradingview/bfx-tv.mjs. Handmatige wijzigingen gaan verloren.
// Versie: 2026-10-28 05:30 UTC
// Paneel = BIAS_5.0-paarindex. Badge, events, band en consensus staan via force_overlay op de koerschart.
indicator("BFX Macro Overlay", shorttitle = "BFX Macro", overlay = false, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 200)

// ─── Instellingen ───────────────────────────────────────────────
const string GV = "Weergave"
const string GC = "Kleuren"
i_ccys      = input.string("", "Paar (leeg = automatisch)", tooltip = "Bijv. EUR,USD. Leeg = basis- en noteringsvaluta van de chart.", group = GV)
i_minImpact = input.int(2, "Minimale impact events", minval = 1, maxval = 3, tooltip = "1 = laag, 2 = medium, 3 = hoog", group = GV)
i_pastDays  = input.int(7, "Afgelopen events tonen (dagen)", minval = 0, maxval = 30, group = GV)
i_lines     = input.bool(true, "Verticale eventlijnen", group = GV)
i_labels    = input.bool(true, "Eventlabels", group = GV)
i_zones     = input.bool(true, "Risicozones rond hoge-impact events", group = GV)
i_zoneBef   = input.int(30, "Eventrisico high impact: minuten vóór", minval = 0, maxval = 720, group = GV)
i_zoneAft   = input.int(60, "Eventrisico high impact: minuten na", minval = 0, maxval = 1440, group = GV)
i_cbBef     = input.int(60, "Eventrisico centrale bank: minuten vóór", minval = 0, maxval = 720, group = GV)
i_cbAft     = input.int(120, "Eventrisico centrale bank: minuten na", minval = 0, maxval = 1440, group = GV)
i_zoneMed   = input.bool(false, "Eventrisico ook bij medium impact", group = GV)
i_band      = input.bool(true, "Band 'koers al gelopen' (±1σ/±2σ)", group = GV)
i_bandLen   = input.int(20, "Band: ankerafstand (balken)", minval = 5, maxval = 200, group = GV)
i_bandSd    = input.int(250, "Band: σ over balken", minval = 50, maxval = 1000, group = GV)
i_cons      = input.bool(true, "Consensus bankkoersdoelen", group = GV)
i_table     = input.bool(true, "Overzichtstabel", group = GV)
i_ccyRows   = input.bool(false, "Regels per valuta tonen", group = GV)
i_rows      = input.int(0, "Extra events onder de kaart", minval = 0, maxval = 20, group = GV)
i_tablePos  = input.string("Rechtsboven", "Positie tabel", options = ["Rechtsboven", "Rechtsonder", "Linksboven", "Linksonder"], group = GV)
i_tz        = input.string("Europe/Amsterdam", "Tijdzone voor tijden", tooltip = "IANA-naam, bijv. Europe/Amsterdam of UTC. De beurstijdzone van het symbool (OANDA = New York) wijkt vaak af van je chart.", group = GV)
i_staleDays = input.int(3, "Waarschuw als data ouder is dan (dagen)", minval = 1, maxval = 30, group = GV)
c_high      = input.color(#E5484D, "Hoge impact", group = GC)
c_med       = input.color(#F5A524, "Medium impact", group = GC)
c_low       = input.color(#8B8D98, "Lage impact", group = GC)
c_bull      = input.color(#30A46C, "Bullish", group = GC)
c_bear      = input.color(#E5484D, "Bearish", group = GC)

// ─── Datatypes ──────────────────────────────────────────────────
type MacroEvent
    int    t
    string ccy
    int    impact
    string title
    string stats
    string detail
    bool   cb
    float  sur
    string up
    string down
    string inl
    string mix

// BIAS 5.0 per paar (mirror_bias50_paar). idx > 0 = basisvaluta sterker.
type PairBias
    string basis
    string quote
    float  idx
    string lbl
    string tekst
    string emmer
    float  z
    string bevestiging
    string status

// BIAS 5.0 per valuta (mirror_bias50 + mirror_bias50_samenvatting)
type CcyBias
    string ccy
    float  idx
    float  kern
    float  dekking
    string lbl
    string zekerheid
    bool   conflict
    string bevestiging
    string kantelpunt
    string samenvatting

// Bankconsensus (mirror_fx_consensus, n_banken ≥ 3)
type Consensus
    string paar
    float  mediaan
    float  bmin
    float  bmax
    int    n
    float  herziening
    string herzBasis
    int    eind
    string lbl
    float  afstandPct

var array<MacroEvent> events = array.new<MacroEvent>()
var array<Consensus>  cons   = array.new<Consensus>()
var array<PairBias>   pairs  = array.new<PairBias>()
var array<CcyBias>    ccyb   = array.new<CcyBias>()

addEv(int t, string ccy, int impact, string title, string stats, string detail, bool cb, float sur, string up, string down, string inl, string mix) =>
    events.push(MacroEvent.new(t, ccy, impact, title, stats, detail, cb, sur, up, down, inl, mix))

// Paarthese uit mirror_outlook_paar (nieuwste periode)
type Inval
    string paar
    string tekst
    string katalysator
    string horizon
    int    periode

var array<Inval> invs = array.new<Inval>()

addInv(string paar, string tekst, string katalysator, string horizon, int periode) =>
    invs.push(Inval.new(paar, tekst, katalysator, horizon, periode))

addPair(string basis, string quote, float idx, string lbl, string tekst, string emmer, float z, string bevestiging, string status) =>
    pairs.push(PairBias.new(basis, quote, idx, lbl, tekst, emmer, z, bevestiging, status))

addCcy(string ccy, float idx, float kern, float dekking, string lbl, string zekerheid, bool conflict, string bevestiging, string kantelpunt, string samenvatting) =>
    ccyb.push(CcyBias.new(ccy, idx, kern, dekking, lbl, zekerheid, conflict, bevestiging, kantelpunt, samenvatting))

addCons(string paar, float mediaan, float bmin, float bmax, int n, float herziening, string herzBasis, int eind, string lbl, float afstandPct) =>
    cons.push(Consensus.new(paar, mediaan, bmin, bmax, n, herziening, herzBasis, eind, lbl, afstandPct))

